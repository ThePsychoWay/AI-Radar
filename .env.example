# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# RSS Feeds (optional; can override in config/feeds.yaml)
RSS_FEEDS="https://news.ycombinator.com/rss,https://arxiv.org/rss/cs.AI"

# GitHub API (public access, no token required for basic queries)
# Only set if you hit rate limits: GITHUB_TOKEN=ghp_xxxxx

# Data directories
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
OUTPUT_DIR=./output

# Database
DB_PATH=./data/radar.db

# Logging
LOG_LEVEL=INFO

# Delivery (Phase 15 - optional)
# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=recipient@example.com

# Google Drive (optional)
# Set up via Google Cloud Console OAuth
GOOGLE_CREDENTIALS_PATH=./config/google_credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Digest Settings
MAX_DIGEST_ITEMS=15
MIN_ITEM_RANK=5.0  # Items below this are in IGNORE section
HIGH_PRIORITY_TOPICS=LLMs,agents,reasoning,research
LOW_PRIORITY_TOPICS=funding,news,rumors
