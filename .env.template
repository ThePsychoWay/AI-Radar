# AI RADAR Environment Configuration
# Copy this file to .env and configure with your values

# Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///./ai_radar.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_radar
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Email Configuration (SMTP)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM_NAME=AI RADAR

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#general

# X (Twitter) Configuration
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret
X_BEARER_TOKEN=your-x-bearer-token

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
# Add custom webhooks:
# WEBHOOK_CUSTOM_URL=https://your-webhook.example.com/ai-radar
# WEBHOOK_ANALYTICS_URL=https://analytics.example.com/events

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Collection Configuration
COLLECTION_INTERVAL_HOURS=6
DIGEST_SCHEDULE=0 8 * * *  # 8 AM UTC (13:30 IST)

# Optional: Cloud Storage (for backups)
# AWS S3
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=ai-radar-backups

# Google Cloud Storage
# GCP_PROJECT_ID=your-project
# GCP_CREDENTIALS_JSON={...}
# GCS_BUCKET=ai-radar-backups
