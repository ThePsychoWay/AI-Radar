# AI RADAR Production Environment Configuration
# IMPORTANT: Change all values to match your production setup
# Never commit actual secrets to version control!

# Environment
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate-a-strong-random-key-here

# Database Configuration
# Use PostgreSQL in production
DATABASE_URL=postgresql://user:password@db.example.com:5432/ai_radar_prod
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Email Configuration (SMTP)
# Use a professional email service (SendGrid, AWS SES, etc)
EMAIL_SMTP_SERVER=smtp.sendgrid.net
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=apikey
EMAIL_SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=AI RADAR

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/PRODUCTION/WEBHOOK
SLACK_CHANNEL=#ai-radar-alerts

# X (Twitter) Configuration
X_API_KEY=your-production-x-api-key
X_API_SECRET=your-production-x-api-secret
X_ACCESS_TOKEN=your-production-x-access-token
X_ACCESS_TOKEN_SECRET=your-production-x-access-token-secret
X_BEARER_TOKEN=your-production-x-bearer-token

# Webhook Configuration
WEBHOOK_SECRET=your-long-random-webhook-secret
WEBHOOK_ANALYTICS_URL=https://analytics.yourdomain.com/ai-radar

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=8

# Collection Configuration
COLLECTION_INTERVAL_HOURS=6
DIGEST_SCHEDULE=0 8 * * *

# AWS S3 (Backups)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=ai-radar-prod-backups
AWS_REGION=us-east-1

# Monitoring & Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345
LOG_LEVEL=INFO
